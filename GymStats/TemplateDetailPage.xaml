<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GymStats.TemplateDetailPage"
             Title="Шаблон">
    <Grid RowDefinitions="Auto,*,Auto">
        <VerticalStackLayout Grid.Row="0" Padding="22,28,22,16" Spacing="4">
            <Label Text="{Binding TemplateName}" Style="{StaticResource PageTitle}" />
            <Label Text="Настрой цели перед стартом." Style="{StaticResource PageSubtitle}" />
        </VerticalStackLayout>
        <CollectionView Grid.Row="1" ItemsSource="{Binding TemplateExercises}" Margin="22,0" SelectionMode="None">
            <CollectionView.EmptyView><Label Text="Добавь упражнения в шаблон." Style="{StaticResource EmptyText}" VerticalOptions="Center" /></CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout>
                                    <Label Text="{Binding Exercise.Name}" Style="{StaticResource CardTitle}" />
                                    <Label Text="{Binding Exercise.MuscleGroup}" Style="{StaticResource CardMeta}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1" Text="×" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveExerciseCommand}" CommandParameter="{Binding .}" Style="{StaticResource IconButton}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                                <VerticalStackLayout><Label Text="Подходы" Style="{StaticResource FieldLabel}" /><Entry Text="{Binding TargetSets}" Keyboard="Numeric" Style="{StaticResource Input}" /></VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1"><Label Text="Повторы" Style="{StaticResource FieldLabel}" /><Entry Text="{Binding TargetReps}" Keyboard="Numeric" Style="{StaticResource Input}" /></VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2"><Label Text="Вес" Style="{StaticResource FieldLabel}" /><Entry Text="{Binding TargetWeight}" Keyboard="Numeric" Style="{StaticResource Input}" /></VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="3"><Label Text="RPE" Style="{StaticResource FieldLabel}" /><Entry Text="{Binding TargetRPE}" Keyboard="Numeric" Style="{StaticResource Input}" /></VerticalStackLayout>
                            </Grid>
                            <Button Text="Сохранить цель" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SaveTargetCommand}" CommandParameter="{Binding .}" Style="{StaticResource SecondaryButton}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <VerticalStackLayout Grid.Row="2" Spacing="8" Padding="22,10,22,22">
            <Button Text="+ Добавить упражнение" Command="{Binding GoToAddExerciseToTemplateCommand}" Style="{StaticResource PrimaryButton}" />
            <Button Text="Удалить шаблон" Command="{Binding DeleteTemplateCommand}" Style="{StaticResource IconButton}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>