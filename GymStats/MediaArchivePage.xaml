<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GymStats.MediaArchivePage"
             BackgroundColor="White">

    <Grid RowDefinitions="Auto, *, Auto">
        <VerticalStackLayout Grid.Row="0" Padding="30,40,30,20" Spacing="5">
            <Label Text="Медиа-архив" FontSize="28" FontAttributes="Bold" TextColor="#2E8B57" />
            <Label Text="Твоя визуальная история прогресса" FontSize="14" TextColor="Gray" />
        </VerticalStackLayout>

        <Grid Grid.Row="1">
            <VerticalStackLayout IsVisible="{Binding IsListEmpty}" VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
                <Label Text="📸" FontSize="60" HorizontalOptions="Center" />
                <Label Text="Пока нет фото. Добавь первое!" FontSize="16" TextColor="Gray" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <CollectionView ItemsSource="{Binding MediaEntries}" SelectionMode="None" Margin="20,0">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BackgroundColor="#F8FFF8" CornerRadius="15" Padding="15" Margin="0,0,0,15" HasShadow="False" BorderColor="#E0E0E0">
                            <Grid ColumnDefinitions="100, *, Auto" RowDefinitions="Auto, Auto">
                                <!-- Миниатюра фото -->
                                <Image Grid.RowSpan="2" Grid.Column="0" Source="{Binding FilePath}" Aspect="AspectFill" HeightRequest="100" WidthRequest="100" />

                                <!-- Описание и дата -->
                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding Date, StringFormat='{0:dd MMMM yyyy}'}" FontSize="14" FontAttributes="Bold" TextColor="#2E8B57" />
                                <Label Grid.Row="1" Grid.Column="1" Text="{Binding Description}" FontSize="14" TextColor="DimGray" LineBreakMode="TailTruncation" MaxLines="2" />

                                <!-- Кнопка удаления -->
                                <Button Grid.RowSpan="2" Grid.Column="2" Text="🗑" FontSize="16" BackgroundColor="Transparent" TextColor="Red" VerticalOptions="Center"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteMediaCommand}" 
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <VerticalStackLayout Grid.Row="2" Spacing="10" Padding="30,20,30,30">
            <Button Text="+ Добавить фото" BackgroundColor="#2E8B57" TextColor="White" FontSize="16" FontAttributes="Bold" CornerRadius="25" HeightRequest="55" Command="{Binding GoToAddMediaCommand}" />
            <Button Text="Назад" BackgroundColor="Transparent" TextColor="Gray" FontSize="14" CornerRadius="25" HeightRequest="45" BorderColor="#E0E0E0" BorderWidth="1" Command="{Binding GoBackCommand}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>