<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GymStats.AddWorkoutPage"
             Title="Новая тренировка">
    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageContent}">
            <VerticalStackLayout Spacing="4">
                <Label Text="Новая тренировка" Style="{StaticResource PageTitle}" />
                <Label Text="Создай с нуля или начни по шаблону." Style="{StaticResource PageSubtitle}" />
            </VerticalStackLayout>
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Название" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding WorkoutName}" Placeholder="Например, День ног" Style="{StaticResource Input}" />
                    <Label Text="Дата" Style="{StaticResource FieldLabel}" />
                    <DatePicker Date="{Binding WorkoutDate}" Format="dd MMMM yyyy" Style="{StaticResource DateInput}" />
                    <Label Text="Шаблон" Style="{StaticResource FieldLabel}" />
                    <Picker ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" ItemDisplayBinding="{Binding Name}" Title="Без шаблона" Style="{StaticResource PickerInput}" />
                </VerticalStackLayout>
            </Border>
            <Button Text="Создать тренировку" Command="{Binding SaveWorkoutCommand}" Style="{StaticResource PrimaryButton}" />
            <Button Text="Отмена" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>