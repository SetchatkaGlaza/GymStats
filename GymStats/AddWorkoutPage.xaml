<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GymStats.AddWorkoutPage"
             BackgroundColor="White"
             Title="Новая тренировка">

    <ScrollView>
        <VerticalStackLayout Padding="30,40" Spacing="25">

            <!-- Заголовок -->
            <VerticalStackLayout Spacing="5">
                <Label Text="Новая тренировка"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="#2E8B57" />
                <Label Text="Укажи дату и выбери шаблон"
                       FontSize="14"
                       TextColor="Gray" />
            </VerticalStackLayout>

            <!-- Карточка с полями -->
            <Frame BackgroundColor="#F8FFF8"
                   CornerRadius="20"
                   Padding="25"
                   HasShadow="False"
                   BorderColor="#E0E0E0">
                <VerticalStackLayout Spacing="20">

                    <!-- Название -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Название"
                               FontSize="14"
                               TextColor="Gray" />
                        <Entry Text="{Binding WorkoutName}"
                               Placeholder="Например: День груди"
                               TextColor="#2E8B57"
                               BackgroundColor="Transparent" />
                    </VerticalStackLayout>

                    <!-- Дата -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Дата тренировки"
                               FontSize="14"
                               TextColor="Gray" />
                        <DatePicker Date="{Binding WorkoutDate}"
                                    Format="dd MMMM yyyy"
                                    TextColor="#2E8B57"
                                    BackgroundColor="Transparent" />
                    </VerticalStackLayout>

                    <!-- Выбор шаблона -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Шаблон (опционально)"
           FontSize="14"
           TextColor="Gray" />

                        <Picker ItemsSource="{Binding Templates}"
            SelectedItem="{Binding SelectedTemplate}"
            ItemDisplayBinding="{Binding Name}"
            TextColor="#2E8B57"
            BackgroundColor="Transparent">
                            <Picker.Title>
                                Выбери шаблон или оставь пустым
                            </Picker.Title>
                        </Picker>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Статус -->
            <Label Text="{Binding StatusMessage}"
                   FontSize="14"
                   TextColor="#2E8B57"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   IsVisible="{Binding IsStatusVisible}" />

            <!-- Кнопки -->
            <Button Text="Создать и добавить упражнения"
                    BackgroundColor="#2E8B57"
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    CornerRadius="25"
                    HeightRequest="55"
                    Command="{Binding SaveWorkoutCommand}" />
            <Button Text="Отмена"
                    BackgroundColor="Transparent"
                    TextColor="Gray"
                    FontSize="14"
                    CornerRadius="25"
                    HeightRequest="45"
                    BorderColor="#E0E0E0"
                    BorderWidth="1"
                    Command="{Binding CancelCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>