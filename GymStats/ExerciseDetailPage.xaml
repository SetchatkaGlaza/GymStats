<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GymStats.ExerciseDetailPage"
             BackgroundColor="White">

    <Grid RowDefinitions="Auto, *, Auto">
        <VerticalStackLayout Grid.Row="0" Padding="30,40,30,20" Spacing="5">
            <Label Text="{Binding ExerciseName}" FontSize="28" FontAttributes="Bold" TextColor="#2E8B57" />
            <Label Text="Добавь подходы" FontSize="14" TextColor="Gray" />
        </VerticalStackLayout>

        <Grid Grid.Row="1">
            <VerticalStackLayout IsVisible="{Binding IsListEmpty}" VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
                <Label Text="📊" FontSize="60" HorizontalOptions="Center" />
                <Label Text="Пока нет подходов" FontSize="16" TextColor="Gray" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <CollectionView ItemsSource="{Binding Sets}" SelectionMode="None" Margin="20,0">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BackgroundColor="#F8FFF8" CornerRadius="15" Padding="20" Margin="0,0,0,15" HasShadow="False" BorderColor="#E0E0E0">
                            <Grid ColumnDefinitions="*, *, *, *" RowDefinitions="Auto, Auto">
                                <Label Grid.Row="0" Grid.Column="0" Text="Вес" FontSize="12" TextColor="Gray" />
                                <Label Grid.Row="1" Grid.Column="0" Text="{Binding Weight, StringFormat='{0:F1} кг'}" FontSize="16" FontAttributes="Bold" TextColor="#2E8B57" />

                                <Label Grid.Row="0" Grid.Column="1" Text="Повт" FontSize="12" TextColor="Gray" />
                                <Label Grid.Row="1" Grid.Column="1" Text="{Binding Reps}" FontSize="16" FontAttributes="Bold" TextColor="#2E8B57" />

                                <Label Grid.Row="0" Grid.Column="2" Text="RPE" FontSize="12" TextColor="Gray" />
                                <Label Grid.Row="1" Grid.Column="2" Text="{Binding RPE}" FontSize="16" FontAttributes="Bold" TextColor="#2E8B57" />

                                <Label Grid.Row="0" Grid.Column="3" Text="Темп" FontSize="12" TextColor="Gray" />
                                <Label Grid.Row="1" Grid.Column="3" Text="{Binding Tempo}" FontSize="16" FontAttributes="Bold" TextColor="#2E8B57" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <VerticalStackLayout Grid.Row="2" Spacing="10" Padding="30,20,30,30">
            <Button Text="+ Добавить подход" BackgroundColor="#2E8B57" TextColor="White" FontSize="16" FontAttributes="Bold" CornerRadius="25" HeightRequest="55" Command="{Binding GoToAddSetCommand}" />
            <Button Text="Назад к упражнениям" BackgroundColor="Transparent" TextColor="Gray" FontSize="14" CornerRadius="25" HeightRequest="45" BorderColor="#E0E0E0" BorderWidth="1" Command="{Binding GoBackCommand}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>