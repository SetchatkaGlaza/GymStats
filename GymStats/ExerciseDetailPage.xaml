<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GymStats.ExerciseDetailPage"
             Title="Упражнение">
    <Grid RowDefinitions="Auto,*,Auto">
        <VerticalStackLayout Grid.Row="0" Padding="22,28,22,16" Spacing="4">
            <Label Text="{Binding ExerciseName}" Style="{StaticResource PageTitle}" />
            <Label Text="{Binding TargetSummary}" Style="{StaticResource PageSubtitle}" />
        </VerticalStackLayout>
        <CollectionView Grid.Row="1" ItemsSource="{Binding Sets}" SelectionMode="None" Margin="22,0">
            <CollectionView.EmptyView><VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center"><Label Text="Добавь первый подход." Style="{StaticResource EmptyText}" /></VerticalStackLayout></CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <Grid ColumnDefinitions="*,*,*,Auto">
                            <VerticalStackLayout><Label Text="Вес" Style="{StaticResource FieldLabel}" /><Label Text="{Binding Weight, StringFormat='{0:0.#} кг'}" Style="{StaticResource CardTitle}" /></VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1"><Label Text="Повторы" Style="{StaticResource FieldLabel}" /><Label Text="{Binding Reps}" Style="{StaticResource CardTitle}" /></VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2"><Label Text="RPE" Style="{StaticResource FieldLabel}" /><Label Text="{Binding RPE}" Style="{StaticResource CardTitle}" /></VerticalStackLayout>
                            <Button Grid.Column="3" Text="×" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteSetCommand}" CommandParameter="{Binding .}" Style="{StaticResource IconButton}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <VerticalStackLayout Grid.Row="2" Spacing="8" Padding="22,10,22,22">
            <Button Text="+ Добавить подход" Command="{Binding GoToAddSetCommand}" Style="{StaticResource PrimaryButton}" />
            <Button Text="Назад" Command="{Binding GoBackCommand}" Style="{StaticResource SecondaryButton}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>