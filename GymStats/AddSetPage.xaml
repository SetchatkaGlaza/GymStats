<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GymStats.AddSetPage"
             Title="Новый подход">
    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageContent}">
            <VerticalStackLayout Spacing="4">
                <Label Text="Новый подход" Style="{StaticResource PageTitle}" />
                <Label Text="Запиши фактический результат подхода." Style="{StaticResource PageSubtitle}" />
            </VerticalStackLayout>
            <Border Style="{StaticResource Card}" IsVisible="{Binding HasPreviousPerformance}">
                <Label Text="{Binding PreviousPerformance}" Style="{StaticResource CardMeta}" />
            </Border>
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Вес (кг)" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding Weight}" Placeholder="0" Keyboard="Numeric" Style="{StaticResource Input}" />
                    <Label Text="Повторения" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding Reps}" Keyboard="Numeric" Style="{StaticResource Input}" />
                    <Label Text="RPE (1–10)" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding Rpe}" Keyboard="Numeric" Style="{StaticResource Input}" />
                    <Label Text="Темп" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding Tempo}" Placeholder="3-1-1-0" Style="{StaticResource Input}" />
                </VerticalStackLayout>
            </Border>
            <Label Text="{Binding StatusMessage}" Style="{StaticResource ErrorText}" IsVisible="{Binding IsStatusVisible}" />
            <Button Text="Сохранить подход" Command="{Binding SaveSetCommand}" Style="{StaticResource PrimaryButton}" />
            <Button Text="Отмена" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>