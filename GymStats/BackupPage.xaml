<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GymStats.BackupPage"
             Title="Данные">
    <VerticalStackLayout Style="{StaticResource PageContent}">
        <VerticalStackLayout Spacing="4">
            <Label Text="Резервная копия" Style="{StaticResource PageTitle}" />
            <Label Text="Один ZIP хранит историю и медиафайлы." Style="{StaticResource PageSubtitle}" />
        </VerticalStackLayout>
        <Border Style="{StaticResource Card}">
            <VerticalStackLayout Spacing="12">
                <Label Text="Полный локальный экспорт" Style="{StaticResource SectionTitle}" />
                <Label Text="{Binding Status}" Style="{StaticResource CardMeta}" />
                <Button Text="Создать и поделиться ZIP" Command="{Binding ExportCommand}" Style="{StaticResource PrimaryButton}" />
            </VerticalStackLayout>
        </Border>
        <Label Text="В архив попадают тренировки, подходы, шаблоны, упражнения, замеры, а также найденные фото и видео прогресса." Style="{StaticResource CardMeta}" />
    </VerticalStackLayout>
</ContentPage>