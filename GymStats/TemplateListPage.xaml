<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GymStats.TemplateListPage"
             Title="Шаблоны">
    <Grid RowDefinitions="Auto,*,Auto">
        <VerticalStackLayout Grid.Row="0" Padding="22,28,22,16" Spacing="4">
            <Label Text="Шаблоны" Style="{StaticResource PageTitle}" />
            <Label Text="Один раз настрой — потом запускай в пару касаний." Style="{StaticResource PageSubtitle}" />
        </VerticalStackLayout>
        <CollectionView Grid.Row="1" ItemsSource="{Binding Templates}" Margin="22,0" SelectionMode="None">
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8"><Label Text="☰" Style="{StaticResource EmptyIcon}" /><Label Text="Создай первый шаблон тренировки." Style="{StaticResource EmptyText}" /></VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout>
                                <Label Text="{Binding Name}" Style="{StaticResource CardTitle}" />
                                <Label Text="{Binding TemplateExercises.Count, StringFormat='Упражнений: {0}'}" Style="{StaticResource CardMeta}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="›" FontSize="28" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                            <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenTemplateCommand}" CommandParameter="{Binding .}" /></Grid.GestureRecognizers>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Button Grid.Row="2" Text="+ Новый шаблон" Command="{Binding GoToAddTemplateCommand}" Style="{StaticResource PrimaryButton}" Margin="22,10,22,22" />
    </Grid>
</ContentPage>