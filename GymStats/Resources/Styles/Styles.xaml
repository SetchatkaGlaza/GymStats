<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Background}, Dark=#111612}" />
    </Style>
    <Style x:Key="PageContent" TargetType="VerticalStackLayout"><Setter Property="Padding" Value="22,24,22,28" /><Setter Property="Spacing" Value="14" /></Style>
    <Style x:Key="PageTitle" TargetType="Label"><Setter Property="FontFamily" Value="OpenSansSemibold" /><Setter Property="FontSize" Value="30" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Text}, Dark={StaticResource White}}" /></Style>
    <Style x:Key="PageSubtitle" TargetType="Label"><Setter Property="FontSize" Value="14" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextMuted}, Dark=#AAB6AE}" /></Style>
    <Style x:Key="SectionTitle" TargetType="Label"><Setter Property="FontFamily" Value="OpenSansSemibold" /><Setter Property="FontSize" Value="18" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Text}, Dark={StaticResource White}}" /></Style>
    <Style x:Key="FieldLabel" TargetType="Label"><Setter Property="FontSize" Value="12" /><Setter Property="FontFamily" Value="OpenSansSemibold" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextMuted}, Dark=#AAB6AE}" /></Style>
    <Style x:Key="CardTitle" TargetType="Label"><Setter Property="FontFamily" Value="OpenSansSemibold" /><Setter Property="FontSize" Value="16" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Text}, Dark={StaticResource White}}" /></Style>
    <Style x:Key="CardMeta" TargetType="Label"><Setter Property="FontSize" Value="13" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextMuted}, Dark=#AAB6AE}" /></Style>
    <Style x:Key="Badge" TargetType="Label"><Setter Property="FontSize" Value="11" /><Setter Property="FontFamily" Value="OpenSansSemibold" /><Setter Property="TextColor" Value="{StaticResource Primary}" /></Style>
    <Style x:Key="StatLabel" TargetType="Label"><Setter Property="FontSize" Value="12" /><Setter Property="TextColor" Value="{StaticResource TextMuted}" /></Style>
    <Style x:Key="StatValue" TargetType="Label"><Setter Property="FontFamily" Value="OpenSansSemibold" /><Setter Property="FontSize" Value="24" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Text}, Dark={StaticResource White}}" /></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark=#1B211D}" /><Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Border}, Dark=#303A33}" /><Setter Property="StrokeThickness" Value="1" /><Setter Property="Padding" Value="16" /><Setter Property="StrokeShape"><Setter.Value><RoundRectangle CornerRadius="18" /></Setter.Value></Setter></Style>
    <Style x:Key="StatCard" TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Padding" Value="14" /></Style>
    <Style x:Key="PreviousCard" TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#EAF6EF, Dark=#18271D}" /><Setter Property="Stroke" Value="{StaticResource PrimarySoft}" /></Style>
    <Style x:Key="Input" TargetType="Entry"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceMuted}, Dark=#222A25}" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Text}, Dark={StaticResource White}}" /><Setter Property="PlaceholderColor" Value="{StaticResource TextMuted}" /><Setter Property="FontSize" Value="15" /><Setter Property="MinimumHeightRequest" Value="48" /></Style>
    <Style x:Key="EditorInput" TargetType="Editor"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceMuted}, Dark=#222A25}" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Text}, Dark={StaticResource White}}" /><Setter Property="PlaceholderColor" Value="{StaticResource TextMuted}" /><Setter Property="FontSize" Value="15" /><Setter Property="MinimumHeightRequest" Value="100" /></Style>
    <Style x:Key="PickerInput" TargetType="Picker"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceMuted}, Dark=#222A25}" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Text}, Dark={StaticResource White}}" /><Setter Property="TitleColor" Value="{StaticResource TextMuted}" /><Setter Property="FontSize" Value="15" /><Setter Property="MinimumHeightRequest" Value="48" /></Style>
    <Style x:Key="DateInput" TargetType="DatePicker"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceMuted}, Dark=#222A25}" /><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Text}, Dark={StaticResource White}}" /><Setter Property="FontSize" Value="15" /><Setter Property="MinimumHeightRequest" Value="48" /></Style>
    <Style x:Key="PrimaryButton" TargetType="Button"><Setter Property="BackgroundColor" Value="{StaticResource Primary}" /><Setter Property="TextColor" Value="{StaticResource White}" /><Setter Property="FontFamily" Value="OpenSansSemibold" /><Setter Property="FontSize" Value="15" /><Setter Property="CornerRadius" Value="16" /><Setter Property="HeightRequest" Value="52" /></Style>
    <Style x:Key="SecondaryButton" TargetType="Button"><Setter Property="BackgroundColor" Value="{StaticResource PrimarySoft}" /><Setter Property="TextColor" Value="{StaticResource PrimaryDark}" /><Setter Property="FontFamily" Value="OpenSansSemibold" /><Setter Property="FontSize" Value="14" /><Setter Property="CornerRadius" Value="16" /><Setter Property="HeightRequest" Value="48" /></Style>
    <Style x:Key="TertiaryButton" TargetType="Button"><Setter Property="BackgroundColor" Value="Transparent" /><Setter Property="TextColor" Value="{StaticResource TextMuted}" /><Setter Property="FontSize" Value="14" /><Setter Property="HeightRequest" Value="44" /></Style>
    <Style x:Key="IconButton" TargetType="Button"><Setter Property="BackgroundColor" Value="Transparent" /><Setter Property="TextColor" Value="{StaticResource Primary}" /><Setter Property="FontSize" Value="20" /><Setter Property="Padding" Value="6" /><Setter Property="WidthRequest" Value="48" /><Setter Property="HeightRequest" Value="48" /></Style>
    <Style x:Key="ErrorText" TargetType="Label"><Setter Property="TextColor" Value="{StaticResource Danger}" /><Setter Property="FontSize" Value="13" /></Style>
    <Style x:Key="EmptyIcon" TargetType="Label"><Setter Property="FontSize" Value="46" /><Setter Property="HorizontalOptions" Value="Center" /></Style>
    <Style x:Key="EmptyText" TargetType="Label"><Setter Property="TextColor" Value="{StaticResource TextMuted}" /><Setter Property="HorizontalOptions" Value="Center" /><Setter Property="HorizontalTextAlignment" Value="Center" /></Style>
    <Style TargetType="Button"><Setter Property="MinimumHeightRequest" Value="44" /></Style>
</ResourceDictionary>