<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GymStats.FinishWorkoutPage"
             Title="Завершение">
    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageContent}">
            <VerticalStackLayout Spacing="4">
                <Label Text="Завершение" Style="{StaticResource PageTitle}" />
                <Label Text="Сохрани название и мысли после тренировки." Style="{StaticResource PageSubtitle}" />
            </VerticalStackLayout>
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Название" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding WorkoutName}" Style="{StaticResource Input}" />
                    <Label Text="Заметки" Style="{StaticResource FieldLabel}" />
                    <Editor Text="{Binding Notes}" Placeholder="Самочувствие, техника, выводы..." Style="{StaticResource EditorInput}" />
                </VerticalStackLayout>
            </Border>
            <Label Text="{Binding StatusMessage}" Style="{StaticResource ErrorText}" IsVisible="{Binding IsStatusVisible}" />
            <Button Text="Сохранить тренировку" Command="{Binding SaveAndFinishCommand}" Style="{StaticResource PrimaryButton}" />
            <Button Text="Назад" Command="{Binding GoBackCommand}" Style="{StaticResource SecondaryButton}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>