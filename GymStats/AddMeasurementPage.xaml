<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GymStats.AddMeasurementPage"
             Title="Новые замеры">
    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageContent}">
            <VerticalStackLayout Spacing="4">
                <Label Text="Новые замеры" Style="{StaticResource PageTitle}" />
                <Label Text="Заполни только те показатели, которые измерял сегодня." Style="{StaticResource PageSubtitle}" />
            </VerticalStackLayout>
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Дата" Style="{StaticResource FieldLabel}" />
                    <DatePicker Date="{Binding MeasurementDate}" Format="dd MMMM yyyy" Style="{StaticResource DateInput}" />
                    <Label Text="Вес тела, кг *" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding Weight}" Keyboard="Numeric" Placeholder="80.5" Style="{StaticResource Input}" />
                    <Label Text="Грудь, см" Style="{StaticResource FieldLabel}" /><Entry Text="{Binding Chest}" Keyboard="Numeric" Style="{StaticResource Input}" />
                    <Label Text="Талия, см" Style="{StaticResource FieldLabel}" /><Entry Text="{Binding Waist}" Keyboard="Numeric" Style="{StaticResource Input}" />
                    <Label Text="Бедра, см" Style="{StaticResource FieldLabel}" /><Entry Text="{Binding Hips}" Keyboard="Numeric" Style="{StaticResource Input}" />
                    <Label Text="Бицепс, см" Style="{StaticResource FieldLabel}" /><Entry Text="{Binding Biceps}" Keyboard="Numeric" Style="{StaticResource Input}" />
                    <Label Text="Бедро, см" Style="{StaticResource FieldLabel}" /><Entry Text="{Binding Thigh}" Keyboard="Numeric" Style="{StaticResource Input}" />
                    <Label Text="Икра, см" Style="{StaticResource FieldLabel}" /><Entry Text="{Binding Calf}" Keyboard="Numeric" Style="{StaticResource Input}" />
                    <Label Text="Шея, см" Style="{StaticResource FieldLabel}" /><Entry Text="{Binding Neck}" Keyboard="Numeric" Style="{StaticResource Input}" />
                </VerticalStackLayout>
            </Border>
            <Label Text="{Binding StatusMessage}" Style="{StaticResource ErrorText}" IsVisible="{Binding IsStatusVisible}" />
            <Button Text="Сохранить замеры" Command="{Binding SaveMeasurementCommand}" Style="{StaticResource PrimaryButton}" />
            <Button Text="Отмена" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>