<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GymStats.MainPage"
             BackgroundColor="White">

    <Grid RowDefinitions="Auto, *, Auto">
        <VerticalStackLayout Grid.Row="0" Padding="30,40,30,20" Spacing="5">
            <Label Text="GymStats" FontSize="32" FontAttributes="Bold" TextColor="#2E8B57" />
            <Label Text="История тренировок" FontSize="14" TextColor="Gray" />
        </VerticalStackLayout>

        <Grid Grid.Row="1">
            <VerticalStackLayout IsVisible="{Binding IsListEmpty}" VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
                <Label Text="🏋️" FontSize="60" HorizontalOptions="Center" />
                <Label Text="{Binding EmptyMessage}" FontSize="16" TextColor="Gray" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <CollectionView ItemsSource="{Binding Workouts}" SelectionMode="None" Margin="20,0">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BackgroundColor="#F8FFF8" CornerRadius="15" Padding="20" Margin="0,0,0,15" HasShadow="False" BorderColor="#E0E0E0">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenWorkoutCommand}" CommandParameter="{Binding .}" />
                            </Frame.GestureRecognizers>
                            <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontSize="18" FontAttributes="Bold" TextColor="#2E8B57" />
                                <Label Grid.Row="1" Grid.Column="0" Text="{Binding Date, StringFormat='{0:dd MMMM yyyy}'}" FontSize="14" TextColor="DimGray" />
                                <Label Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Text="→" FontSize="24" TextColor="#2E8B57" VerticalOptions="Center" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <VerticalStackLayout Grid.Row="2" Spacing="10" Padding="30,20,30,30">
            <Button Text="+ Новая тренировка" BackgroundColor="#2E8B57" TextColor="White" FontSize="16" FontAttributes="Bold" CornerRadius="25" HeightRequest="55" Command="{Binding GoToAddWorkoutCommand}" />
            <Button Text="📋 Шаблоны тренировок" BackgroundColor="Transparent" TextColor="#2E8B57" FontSize="14" CornerRadius="25" HeightRequest="45" BorderColor="#2E8B57" BorderWidth="1" Command="{Binding GoToTemplatesCommand}" />
            <Button Text=" Замеры тела" BackgroundColor="Transparent" TextColor="#2E8B57" FontSize="14" CornerRadius="25" HeightRequest="45" BorderColor="#2E8B57" BorderWidth="1" Command="{Binding GoToAnthropometryCommand}" />
            <Button Text="📈 Аналитика и графики" BackgroundColor="Transparent" TextColor="#2E8B57" FontSize="14" CornerRadius="25" HeightRequest="45" BorderColor="#2E8B57" BorderWidth="1" Command="{Binding GoToAnalyticsCommand}" />
            <!-- ДОБАВИТЬ ЭТУ КНОПКУ -->
            <Button Text="📸 Медиа-архив" BackgroundColor="Transparent" TextColor="#2E8B57" FontSize="14" CornerRadius="25" HeightRequest="45" BorderColor="#2E8B57" BorderWidth="1" Command="{Binding GoToMediaArchiveCommand}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>