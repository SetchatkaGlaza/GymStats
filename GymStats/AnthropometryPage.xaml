<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GymStats.AnthropometryPage"
             Title="Замеры">
    <Grid RowDefinitions="Auto,*,Auto">
        <VerticalStackLayout Grid.Row="0" Padding="22,28,22,16" Spacing="4">
            <Label Text="Замеры тела" Style="{StaticResource PageTitle}" />
            <Label Text="Следи за весом и объёмами в динамике." Style="{StaticResource PageSubtitle}" />
        </VerticalStackLayout>
        <CollectionView Grid.Row="1" ItemsSource="{Binding Measurements}" Margin="22,0" SelectionMode="None">
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                    <Label Text="⌁" Style="{StaticResource EmptyIcon}" />
                    <Label Text="Пока нет замеров." Style="{StaticResource EmptyText}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout>
                                    <Label Text="{Binding Date, StringFormat='{0:dd MMMM yyyy}'}" Style="{StaticResource CardTitle}" />
                                    <Label Text="{Binding Weight, StringFormat='Вес  •  {0:0.#} кг'}" Style="{StaticResource CardMeta}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1" Text="×" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteMeasurementCommand}" CommandParameter="{Binding .}" Style="{StaticResource IconButton}" />
                            </Grid>
                            <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start">
                                <Label Text="{Binding Chest, StringFormat='Грудь {0:0.#}  '}" Style="{StaticResource Badge}" Margin="0,0,12,4}" />
                                <Label Text="{Binding Waist, StringFormat='Талия {0:0.#}  '}" Style="{StaticResource Badge}" Margin="0,0,12,4}" />
                                <Label Text="{Binding Hips, StringFormat='Бедра {0:0.#}  '}" Style="{StaticResource Badge}" Margin="0,0,12,4}" />
                                <Label Text="{Binding Biceps, StringFormat='Бицепс {0:0.#}  '}" Style="{StaticResource Badge}" Margin="0,0,12,4}" />
                                <Label Text="{Binding Thigh, StringFormat='Бедро {0:0.#}  '}" Style="{StaticResource Badge}" Margin="0,0,12,4}" />
                                <Label Text="{Binding Calf, StringFormat='Икра {0:0.#}  '}" Style="{StaticResource Badge}" Margin="0,0,12,4}" />
                                <Label Text="{Binding Neck, StringFormat='Шея {0:0.#}'}" Style="{StaticResource Badge}" Margin="0,0,12,4}" />
                            </FlexLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Button Grid.Row="2" Text="+ Добавить замер" Command="{Binding GoToAddMeasurementCommand}" Style="{StaticResource PrimaryButton}" Margin="22,10,22,22" />
    </Grid>
</ContentPage>