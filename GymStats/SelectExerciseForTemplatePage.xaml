<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GymStats.SelectExerciseForTemplatePage"
             Title="Упражнения">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <VerticalStackLayout Grid.Row="0" Padding="22,28,22,12" Spacing="4">
            <Label Text="Добавить упражнение" Style="{StaticResource PageTitle}" />
            <Label Text="Фильтруй базу так же, как при создании тренировки." Style="{StaticResource PageSubtitle}" />
        </VerticalStackLayout>
        <VerticalStackLayout Grid.Row="1" Padding="22,0" Spacing="8">
            <SearchBar Text="{Binding SearchText}" Placeholder="Поиск упражнения..." />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Picker ItemsSource="{Binding MuscleGroups}" SelectedItem="{Binding SelectedMuscleGroup}" Style="{StaticResource PickerInput}" />
                <Picker Grid.Column="1" ItemsSource="{Binding EquipmentOptions}" SelectedItem="{Binding SelectedEquipment}" Style="{StaticResource PickerInput}" />
            </Grid>
            <Picker ItemsSource="{Binding MovementOptions}" SelectedItem="{Binding SelectedMovement}" Style="{StaticResource PickerInput}" />
        </VerticalStackLayout>
        <CollectionView Grid.Row="2" ItemsSource="{Binding Exercises}" SelectionMode="None" Margin="22,10">
            <CollectionView.EmptyView><Label Text="Ничего не найдено." Style="{StaticResource EmptyText}" VerticalOptions="Center" /></CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout><Label Text="{Binding Name}" Style="{StaticResource CardTitle}" /><Label Text="{Binding Equipment}" Style="{StaticResource CardMeta}" /></VerticalStackLayout>
                            <Label Grid.Column="1" Text="+" FontSize="28" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                            <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectExerciseCommand}" CommandParameter="{Binding .}" /></Grid.GestureRecognizers>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Button Grid.Row="3" Text="Назад" Command="{Binding GoBackCommand}" Style="{StaticResource SecondaryButton}" Margin="22,10,22,22" />
    </Grid>
</ContentPage>