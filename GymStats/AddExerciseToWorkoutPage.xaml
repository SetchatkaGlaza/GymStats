<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GymStats.AddExerciseToWorkoutPage"
             Title="Тренировка">
    <Grid RowDefinitions="Auto,*,Auto">
        <VerticalStackLayout Grid.Row="0" Padding="22,28,22,16" Spacing="4">
            <Label Text="{Binding WorkoutName}" Style="{StaticResource PageTitle}" />
            <Label Text="Добавляй упражнения, подходы и заметки." Style="{StaticResource PageSubtitle}" />
        </VerticalStackLayout>
        <Grid Grid.Row="1">
            <VerticalStackLayout IsVisible="{Binding IsListEmpty}" VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                <Label Text="＋" Style="{StaticResource EmptyIcon}" />
                <Label Text="Добавь первое упражнение." Style="{StaticResource EmptyText}" />
            </VerticalStackLayout>
            <CollectionView ItemsSource="{Binding WorkoutExercises}" SelectionMode="None" Margin="22,0">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout>
                                    <Label Text="{Binding Exercise.Name}" Style="{StaticResource CardTitle}" />
                                    <Label Text="{Binding Exercise.MuscleGroup}" Style="{StaticResource CardMeta}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="›" FontSize="28" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                                <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenExerciseDetailCommand}" CommandParameter="{Binding .}" /></Grid.GestureRecognizers>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
        <VerticalStackLayout Grid.Row="2" Spacing="8" Padding="22,10,22,22">
            <Button Text="+ Добавить упражнение" Command="{Binding GoToAddExerciseCommand}" Style="{StaticResource PrimaryButton}" />
            <Button Text="Завершить тренировку" Command="{Binding GoToFinishWorkoutCommand}" Style="{StaticResource SecondaryButton}" />
            <Button Text="Удалить незавершённую тренировку" Command="{Binding DeleteWorkoutCommand}" Style="{StaticResource IconButton}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>