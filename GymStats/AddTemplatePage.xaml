<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GymStats.AddTemplatePage"
             Title="Новый шаблон">
    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageContent}">
            <VerticalStackLayout Spacing="4">
                <Label Text="Новый шаблон" Style="{StaticResource PageTitle}" />
                <Label Text="Создай заготовку, затем добавь упражнения и цели." Style="{StaticResource PageSubtitle}" />
            </VerticalStackLayout>
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Название" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding TemplateName}" Placeholder="Например, День груди" Style="{StaticResource Input}" />
                </VerticalStackLayout>
            </Border>
            <Label Text="{Binding StatusMessage}" Style="{StaticResource ErrorText}" IsVisible="{Binding IsStatusVisible}" />
            <Button Text="Создать шаблон" Command="{Binding SaveTemplateCommand}" Style="{StaticResource PrimaryButton}" />
            <Button Text="Отмена" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>